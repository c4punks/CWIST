{
  "name": "cwist-wasm",
  "version": "3",
  "description": "Fetch-shaped JS API over a CWIST app built as a cwist-guest WASI component and transpiled with jco.",
  "license": "MIT",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./component": {
      "types": "./component.d.ts",
      "default": "./component.js"
    },
    "./component.js": {
      "types": "./component.d.ts",
      "default": "./component.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "component.js",
    "component.d.ts",
    "http.js",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  }
}
