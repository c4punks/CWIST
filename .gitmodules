[submodule "lib/boringssl"]
	path = lib/boringssl
	url = https://github.com/google/boringssl
	branch = main
[submodule "lib/cjson"]
	path = lib/cjson
	url = https://github.com/DaveGamble/cJSON
	branch = master
[submodule "lib/libttak"]
	path = lib/libttak
	url = https://github.com/c4punks/libttak
	branch = main
[submodule "lib/uriparser"]
	path = lib/uriparser
	url = https://github.com/uriparser/uriparser
	branch = master
[submodule "lib/cnats"]
	path = lib/cnats
	url = https://github.com/nats-io/nats.c
	branch = main
[submodule "lib/lsquic"]
	path = lib/lsquic
	url = https://github.com/litespeedtech/lsquic.git
	branch = master
[submodule "lib/multipart-parser-c"]
	path = lib/multipart-parser-c
	url = https://github.com/iafonov/multipart-parser-c.git
	branch = main
